# Configure sua chave NVIDIA somente no ambiente local ou no painel seguro do provedor.
# Nunca coloque chaves reais neste arquivo nem as envie ao GitHub.
NVIDIA_API_KEY=COLOQUE_SUA_CHAVE_NVIDIA_AQUI
# NVIDIA_API_KEYS=CHAVE_1,CHAVE_2

# Opcional: modelo NVIDIA. Se vazio, use o padrão configurado no servidor.
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# JARVIS_PORT=8000

# Integração somente leitura com o Monitor Aviator.
# Configure os mesmos valores no painel seguro do Render; nunca grave tokens reais no Git.
MONITOR_AVIATOR_API_URL=https://SEU-SERVICO-MONITOR-API.onrender.com
MONITOR_AVIATOR_AGENT_TOKEN=COLOQUE_UM_TOKEN_FORTE_COMPARTILHADO_COM_MONITOR_API
MONITOR_AVIATOR_POLL_SECONDS=60
