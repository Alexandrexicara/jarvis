# Preencha somente neste computador. Nunca envie este arquivo ao GitHub.
JARVIS_SERVER_URL=https://SEU-SERVICO.onrender.com
JARVIS_DEVICE_TOKEN=COLE_AQUI_O_TOKEN_DE_PAREAMENTO
JARVIS_WORKSPACE=C:\\Projetos
JARVIS_POLL_SECONDS=5

# Monitoramento e verificações são permitidos; autocorreção vem DESLIGADA por padrão.
JARVIS_AUTO_REPAIR_ENABLED=false
JARVIS_AUTO_REPAIR_MAX_ATTEMPTS=2

# Só autorize pastas específicas depois de revisar o workspace. Exemplo: src,tests
# Não inclua .git, .env, secrets, credentials ou pastas de produção.
JARVIS_AUTO_EDIT_PATHS=
